[Unit]
Description=Reconcile expiring CTH staging leases
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cthstage
Group=cthstage
UMask=0077
ExecStart=/usr/bin/python3 -EsB /opt/cth-staging/infra/staging/controller.py sweep
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/cth-staging
TimeoutStartSec=90
