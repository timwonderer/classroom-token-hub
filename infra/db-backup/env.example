# /etc/cth-db-backup/env  (root:cth-backup, mode 0640). Holds database passwords and
# no decryption key: the host can encrypt recovery points but never read them.

# Read-only role (pg_read_all_data). Not the application role.
CTH_BACKUP_SOURCE_URL=postgresql://cth_backup_reader:CHANGE_ME@localhost/classroom_economy
# Scratch database every dump is restored into and checked against, then emptied.
CTH_BACKUP_VERIFY_URL=postgresql://cth_backup_verify:CHANGE_ME@localhost/cth_backup_verify

# age public key(s), one per line. The matching identity lives in the owner's
# password manager, never on the droplet.
CTH_BACKUP_AGE_RECIPIENTS_FILE=/etc/cth-db-backup/recipients.txt

# rclone remote and path for the off-host copy, configured in the file below.
CTH_BACKUP_REMOTE=cth-offsite:cth-db-backups/production
CTH_BACKUP_RCLONE_CONFIG=/etc/cth-db-backup/rclone.conf

# Retention: newest N points off-host and on the host. Everything older than the
# newest replacement baseline is deleted regardless of these numbers.
CTH_BACKUP_KEEP_REMOTE=14
CTH_BACKUP_KEEP_LOCAL=2
# Health turns STALE when the newest verified point is older than this.
CTH_BACKUP_MAX_AGE_HOURS=26
# Row data left out of every dump (schema kept). Same exclusion as the
# 2026-09-30 and 2026-10-02 pre-release dumps.
CTH_BACKUP_EXCLUDE_TABLE_DATA=teacher_signup_attempts
