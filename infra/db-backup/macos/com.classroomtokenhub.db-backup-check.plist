<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hourly at :15, except 03:15, when the nightly backup runs instead (the runner skips that hour): replacement
     baseline after a protected destruction, and the purge of older points. __HOME__ is replaced at install. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.classroomtokenhub.db-backup-check</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/cth-backup-venv/bin/python</string>
    <string>__HOME__/cth-backup/scheduled/bin/cth_backup_scheduled.py</string>
    <string>check</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Minute</key><integer>15</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/cth-db-backup/check.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/cth-db-backup/check.log</string>
</dict>
</plist>
