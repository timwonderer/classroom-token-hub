[Unit]
Description=Nightly CTH database backup (03:15 Pacific, outside school hours)

[Timer]
# systemd >= 247 accepts a time zone here; the host clock stays UTC.
OnCalendar=*-*-* 03:15:00 America/Los_Angeles
RandomizedDelaySec=10min
Persistent=true
Unit=cth-db-backup.service

[Install]
WantedBy=timers.target
